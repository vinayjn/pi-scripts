# NordVPN service credentials
# Get these from: https://my.nordaccount.com/dashboard/nordvpn/
#   Account -> Services -> NordVPN -> Manual setup -> Service credentials
# (NOT your NordVPN account email/password)
NORDVPN_USER=your-service-username
NORDVPN_PASSWORD=your-service-password

# Preferred VPN exit country (any name gluetun accepts)
VPN_COUNTRY=United Kingdom

# File ownership for downloaded files.
# Fill in with:
#   PUID=$(id -u)
#   PGID=$(getent group media | cut -d: -f3)
PUID=1000
PGID=1001

TZ=Europe/London

# qBittorrent WebUI credentials — applied by ./set-password.sh after first boot
QBT_USER=admin
QBT_PASS=change-me

# Plex claim token — optional, auto-links this server to your Plex account.
# Get one at https://plex.tv/claim (valid ~4 minutes).
# Leave empty to set up manually via http://<pi-ip>:32400/web on first run.
PLEX_CLAIM=
